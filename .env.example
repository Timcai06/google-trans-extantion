# Local backend: copy to root .env; dev/start load it automatically.
# Docker: docker compose --env-file .env -f deploy/compose.yaml up --build -d
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/googletrans.sqlite
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173
# Add chrome-extension://YOUR_EXTENSION_ID and your HTTPS site origin as needed.
SESSION_TTL_DAYS=30
AUTH_RATE_LIMIT=20
SYNC_PAGE_SIZE=100
# Exact OpenAI-compatible chat-completions endpoint; optional for manual word entry.
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
TRANSLATION_MODEL=gpt-4o-mini
TRANSLATION_TIMEOUT_MS=10000
