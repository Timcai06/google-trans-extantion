{
  "name": "word-translation-assistant",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "description": "Chrome extension for word translation with POS recognition",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:legacy": "jest",
    "test:legacy:pos": "jest --roots src",
    "test:legacy:coverage": "jest --coverage --coverageDirectory=build/coverage",
    "test:legacy:pbt": "jest --testPathPattern=property",
    "build": "pnpm run build:web && pnpm run build:extension && pnpm run build:api",
    "build:extension": "pnpm --filter @googletrans/extension build && node scripts/write-root-loader.mjs",
    "build:legacy:pos": "tsc --outDir build/dist",
    "type-check": "pnpm run type-check:core && pnpm --filter @googletrans/data type-check && pnpm --filter @googletrans/api type-check && pnpm --filter @googletrans/web type-check && pnpm --filter @googletrans/mobile type-check && pnpm run type-check:extension",
    "type-check:core": "tsc --project packages/core/tsconfig.json --noEmit",
    "type-check:extension": "pnpm --filter @googletrans/extension type-check",
    "type-check:legacy": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:extension": "node scripts/check-extension.mjs",
    "check": "pnpm run type-check && pnpm run check:boundaries && pnpm test && pnpm build && pnpm run check:extension",
    "build:web": "pnpm --filter @googletrans/web build",
    "build:api": "pnpm --filter @googletrans/api build",
    "build:mobile": "pnpm --filter @googletrans/mobile build",
    "dev:web": "pnpm --filter @googletrans/web dev",
    "dev:api": "pnpm --filter @googletrans/api dev",
    "dev:mobile": "pnpm --filter @googletrans/mobile start",
    "check:all": "pnpm run check && pnpm run build:mobile && pnpm run type-check:legacy && pnpm run test:legacy:pos --runInBand --silent"
  },
  "devDependencies": {
    "@googletrans/core": "workspace:*",
    "@jest/globals": "29.7.0",
    "@types/chrome": "^0.0.268",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.0.0",
    "axe-core": "^4.11.1",
    "esbuild": "0.28.2",
    "fast-check": "^3.15.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^24.0.0",
    "lighthouse": "^13.0.1",
    "ts-jest": "^29.1.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "@googletrans/data": "workspace:*",
    "fake-indexeddb": "6.2.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests",
      "<rootDir>/extension"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts",
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!.*\\.js$)"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/types/**",
      "extension/utils/**/*.js",
      "!extension/utils/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
