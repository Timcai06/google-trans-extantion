{
  "manifest_version": 3,
  "name": "单词翻译助手",
  "description": "划词、语境词库、离线复习与跨设备同步",
  "version": "3.0.0",
  "icons": {
    "16": "apps/extension/.output/chrome-mv3/assets/icon16.png"
  },
  "minimum_chrome_version": "114",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "apps/extension/.output/chrome-mv3/library/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "apps/extension/.output/chrome-mv3/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": false,
      "run_at": "document_idle",
      "js": [
        "apps/extension/.output/chrome-mv3/content-scripts/content.js"
      ],
      "world": "ISOLATED"
    }
  ]
}
